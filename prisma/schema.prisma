generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // 👈 ADD THIS LINE
}

model Tenant {
  id              String           @id @default(uuid())
  companyName     String
  subdomain       String           @unique
  logoUrl         String?
  adminEmail      String           @unique
  createdAt       DateTime         @default(now())
  userId          String?          @unique
  accentColor     String?          @default("#FF8C00")
  buttonColor     String?          @default("#FF8C00")
  headingColor    String?          @default("#1F2937")
  navbarColor     String?          @default("#003580")
  primaryColor    String?          @default("#003580")
  cardColor       String?          @default("#111827")
  footerColor     String?          @default("#111827")
  navlink         String?          @default("#111827")
  isActive        Boolean          @default(true)
  planTier        String           @default("BASIC")
  bookings        Booking[]
  customTourLeads CustomTourLead[]
  promoCodes      PromoCode[]
  tours           Tour[]
  backups         Backup[]
  backupEmail     String?   
  contactEmail  String?
  metaPixelId      String?  
  whatsappNumber   String?  // <-- Yeh nayi line add karein

  allowPartialPayments Boolean @default(false) 

  teamMembers TeamMember[]
  
  // 👇 THIS IS THE FIX: The Tenant reaches back to the ApiKey
  apiKey          ApiKey? 
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique 
  tenantId  String   @unique 
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String
  role      String   @default("AGENT") 
  status    String   @default("PENDING") 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tour {
  id                 String         @id @default(uuid())
  tenantId           String
  title              String
  destination        String
  duration           String
  basePrice          Int
  transportType      String
  accommodation      String
  coverImage         String
  createdAt          DateTime       @default(now())
  status             String         @default("ACTIVE")
  bookingMode        String         @default("BOTH")
  exclusions         String[]
  gallery            String[]
  inclusions         String[]
  overview           String?
  policy             String?
  departureDate      DateTime?
  departureEveryYear Boolean        @default(false)
  departureType      String         @default("CLIENT_CHOICE")
  bookedSpots        Int            @default(0)
  maxCapacity        Int?
  blockedDates       String         @default("[]")
  addOns             String         @default("[]")
  bookings           Booking[]
  itineraryDays      ItineraryDay[]
  tenant             Tenant         @relation(fields: [tenantId], references: [id])
}

model ItineraryDay {
  id        String @id @default(uuid())
  tourId    String
  dayNumber Int
  title     String
  details   String
  tour      Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String   @id @default(uuid())
  tenantId       String
  tourId         String
  customerName   String
  customerEmail  String
  customerPhone  String
  numTravelers   Int
  totalPrice     Int
  status         String   @default("PENDING")
  paymentProof   String?
  createdAt      DateTime @default(now())
  specialNotes   String?
  travelDate     DateTime
  isWaitlist     Boolean  @default(false)
  selectedAddOns String?
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  tour           Tour     @relation(fields: [tourId], references: [id])

  amountPaid     Float    @default(0) 
  paymentStatus  String   @default("UNPAID") 
  
  payments       Payment[] 
}

model Payment {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  amount     Float
  date       DateTime @default(now())
  method     String   
  recordedBy String   
  notes      String?
}

model CustomTourLead {
  id            String   @id @default(cuid())
  tenantId      String
  fullName      String
  email         String
  phone         String
  cityCountry   String?
  dateFrom      String
  dateTo        String
  travelers     String
  accommodation String?
  budget        String?
  destinations  String
  tourTypes     String
  requirements  String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Backup {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  fileName   String
  fileUrl    String
  backupType String   
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
}

model PromoCode {
  id            String    @id @default(cuid())
  tenantId      String
  code          String
  discountType  String
  discountValue Float
  validUntil    DateTime?
  usageLimit    Int?
  timesUsed     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}